# ---------------------------------------------------------------------------
# Where Twilio can reach this server. Must be public HTTPS.
# Local dev:  cloudflared tunnel --url http://localhost:8080
#             ngrok http 8080
# ---------------------------------------------------------------------------
PUBLIC_BASE_URL=https://your-tunnel-hostname.example.com

# --- Twilio (console.twilio.com) -------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15551234567

# --- Your phone: this is the number that rings when a human picks up -------
MY_PHONE_NUMBER=+15559876543

# --- Menu navigation (optional; needed only for mode=auto) -----------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ASR_PROVIDER=none          # 'deepgram' to enable auto mode
DEEPGRAM_API_KEY=

# --- Notifications ---------------------------------------------------------
NOTIFY_SMS=true
# Free push to your phone: install the ntfy app, subscribe to this topic.
# Pick something unguessable -- anyone who knows the topic can read it.
NOTIFY_NTFY_TOPIC=
NOTIFY_PUSHOVER_TOKEN=
NOTIFY_PUSHOVER_USER=

# --- Guardrails ------------------------------------------------------------
# JSON list. Leave empty to allow any destination.
ALLOWED_DESTINATIONS=[]
MAX_CALL_SECONDS=3600
MAX_CONCURRENT_CALLS=3
# 0.0 = alert early and often, 1.0 = only when certain. 0.55 is a good start.
DETECTOR_STRICTNESS=0.55

# Turn off only if you are testing without Twilio. Never in production.
VALIDATE_TWILIO_SIGNATURES=true
